@{
    ViewData["Title"] = "Tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-speedometer2"></i> Tổng quan</h1>
    <a asp-controller="Students" asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm sinh viên mới
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-uppercase">Tổng số sinh viên</h6>
                <p class="display-5 mb-0">@ViewBag.TotalStudents</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-uppercase">Số ngành đào tạo</h6>
                <p class="display-5 mb-0">@ViewBag.TotalCourses</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-uppercase">Năm học</h6>
                <p class="display-5 mb-0">@(((IDictionary<int,int>)ViewBag.YearLevelBreakdown).Count)</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header"><i class="bi bi-bar-chart-fill"></i> Số sinh viên theo năm học</div>
            <ul class="list-group list-group-flush">
                @foreach (var kvp in (IDictionary<int, int>)ViewBag.YearLevelBreakdown)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Năm thứ @kvp.Key
                        <span class="badge bg-primary rounded-pill">@kvp.Value</span>
                    </li>
                }
                @if (((IDictionary<int, int>)ViewBag.YearLevelBreakdown).Count == 0)
                {
                    <li class="list-group-item text-muted">Chưa có dữ liệu..</li>
                }
            </ul>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header"><i class="bi bi-clock-history"></i> Sinh viên được thêm gần đây</div>
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Ngành học</th>
                        <th>Ngày thêm</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in (IEnumerable<StudentManagement.ViewModels.StudentDto>)ViewBag.RecentStudents)
                    {
                        <tr>
                            <td>@s.LastName @s.FirstName</td>
                            <td>@s.Course</td>
                            <td>@s.DateCreated.ToString("g")</td>
                        </tr>
                    }
                    @if (!((IEnumerable<StudentManagement.ViewModels.StudentDto>)ViewBag.RecentStudents).Any())
                    {
                        <tr><td colspan="3" class="text-muted">Chưa có sinh viên nào - click "Thêm sinh viên mới" để bắt đầu.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
