@model StudentDto
@{
    ViewData["Title"] = "Thông tin chi tiết sinh viên";
}

<h1><i class="bi bi-person-lines-fill"></i> Thông tin chi tiết sinh viên</h1>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã sinh viên</dt>
            <dd class="col-sm-8">@Model.StudentNumber</dd>

            <dt class="col-sm-4">Họ và tên</dt>
            <dd class="col-sm-8">@Model.LastName @Model.FirstName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Ngành học</dt>
            <dd class="col-sm-8">@Model.Course</dd>

            <dt class="col-sm-4">Năm học</dt>
            <dd class="col-sm-8">@Model.YearLevel</dd>

            <dt class="col-sm-4">Ngày tạo</dt>
            <dd class="col-sm-8">
                @(Model.DateUpdated.HasValue
    ? Model.DateUpdated.Value.ToString("dd/MM/yyyy HH:mm")
    : "Chưa cập nhật")
            </dd>

            <dt class="col-sm-4">Cập nhật lần cuối</dt>
            <dd class="col-sm-8">@(Model.DateUpdated.HasValue ? Model.DateUpdated.Value.ToString("dd/MM/yyyy HH:mm") : "Never")</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-primary"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>
